{
  "info": {
    "name": "CloudNext Fleet Management API",
    "description": "Complete API collection for CloudNext Fleet Management System.\n\nBase URL: http://localhost:3001/api\n\nAuth: Set {{token}} variable after calling POST /auth/login.\nSet {{tenant_id}} for superadmin cross-tenant queries.\n\nDefault test credentials (from fleet_multitenant_seed.sql):\n- Superadmin: superadmin@cloudnext.solutions / password\n- Tenant admin: admin@naqel-express.fleet / Fleet@2026\n- Operator:     operator@naqel-express.fleet / Fleet@2026\n- Driver:       drv001@naqel-express.fleet / Fleet@2026",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3001/api" },
    { "key": "token",    "value": "" },
    { "key": "tenant_id","value": "" },
    { "key": "vehicle_id","value": "" },
    { "key": "driver_id", "value": "" },
    { "key": "route_id",  "value": "" },
    { "key": "depot_id",  "value": "" },
    { "key": "geofence_id","value": "" },
    { "key": "alert_id",  "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [

    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "exec": [
            "var r = pm.response.json();",
            "if (r.token) {",
            "  pm.collectionVariables.set('token', r.token);",
            "  if (r.user && r.user.tenant_id) pm.collectionVariables.set('tenant_id', r.user.tenant_id);",
            "  console.log('Token saved. Role:', r.user.role);",
            "}"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@naqel-express.fleet\",\n  \"password\": \"Fleet@2026\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth","login"] }
          }
        },
        {
          "name": "Login — Superadmin",
          "event": [{ "listen": "test", "script": { "exec": [
            "var r = pm.response.json();",
            "if (r.token) pm.collectionVariables.set('token', r.token);"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"superadmin@cloudnext.solutions\",\n  \"password\": \"password\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth","login"] }
          }
        },
        {
          "name": "Login — Driver (Viewer)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"drv001@naqel-express.fleet\",\n  \"password\": \"Fleet@2026\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth","login"] }
          }
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/auth/me", "host": ["{{base_url}}"], "path": ["auth","me"] }
          }
        }
      ]
    },

    {
      "name": "Vehicles",
      "item": [
        {
          "name": "List Vehicles",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/vehicles?status=active",
              "host": ["{{base_url}}"], "path": ["vehicles"],
              "query": [
                { "key": "status", "value": "active", "description": "active|idle|offline|maintenance|alert" },
                { "key": "type",   "value": "", "disabled": true, "description": "truck|van|car|bus|motorcycle|heavy" },
                { "key": "search", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "List Vehicles — GeoJSON",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/vehicles/geojson", "host": ["{{base_url}}"], "path": ["vehicles","geojson"] }
          }
        },
        {
          "name": "Get Vehicle by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/vehicles/{{vehicle_id}}", "host": ["{{base_url}}"], "path": ["vehicles","{{vehicle_id}}"] }
          }
        },
        {
          "name": "Get Vehicle Trail",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/vehicles/{{vehicle_id}}/trail?minutes=60",
              "host": ["{{base_url}}"], "path": ["vehicles","{{vehicle_id}}","trail"],
              "query": [{ "key": "minutes", "value": "60" }]
            }
          }
        }
      ]
    },

    {
      "name": "Fleet Management — Vehicles",
      "item": [
        {
          "name": "FM List Vehicles",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/fm/vehicles", "host": ["{{base_url}}"], "path": ["fm","vehicles"] }
          }
        },
        {
          "name": "FM Create Vehicle",
          "event": [{ "listen": "test", "script": { "exec": [
            "var r = pm.response.json();",
            "if (r.vehicle) pm.collectionVariables.set('vehicle_id', r.vehicle.id);"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"registration\": \"TEST-001\",\n  \"make\": \"Isuzu\",\n  \"model\": \"NPR\",\n  \"year\": 2023,\n  \"type\": \"truck\",\n  \"color\": \"White\",\n  \"fuel_type\": \"diesel\",\n  \"fuel_capacity\": 80,\n  \"max_speed\": 120\n}"
            },
            "url": { "raw": "{{base_url}}/fm/vehicles", "host": ["{{base_url}}"], "path": ["fm","vehicles"] }
          }
        },
        {
          "name": "FM Update Vehicle",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"color\": \"Blue\",\n  \"notes\": \"Updated via API\"\n}" },
            "url": { "raw": "{{base_url}}/fm/vehicles/{{vehicle_id}}", "host": ["{{base_url}}"], "path": ["fm","vehicles","{{vehicle_id}}"] }
          }
        },
        {
          "name": "FM Assign Driver to Vehicle",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"driver_id\": \"{{driver_id}}\"\n}" },
            "url": { "raw": "{{base_url}}/fm/vehicles/{{vehicle_id}}/assign-driver", "host": ["{{base_url}}"], "path": ["fm","vehicles","{{vehicle_id}}","assign-driver"] }
          }
        },
        {
          "name": "FM Assign Route to Vehicle",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"route_id\": \"{{route_id}}\"\n}" },
            "url": { "raw": "{{base_url}}/fm/vehicles/{{vehicle_id}}/assign-route", "host": ["{{base_url}}"], "path": ["fm","vehicles","{{vehicle_id}}","assign-route"] }
          }
        },
        {
          "name": "FM Delete Vehicle",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/fm/vehicles/{{vehicle_id}}", "host": ["{{base_url}}"], "path": ["fm","vehicles","{{vehicle_id}}"] }
          }
        }
      ]
    },

